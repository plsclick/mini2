{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BUILD PULSE",
  "version": "0.1.0",
  "identifier": "com.buildpulse.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "BUILD//PULSE",
        "width": 1280,
        "height": 800,
        "minWidth": 390,
        "minHeight": 640
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
