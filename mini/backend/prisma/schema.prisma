generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  CLIENT
  PROJECT_MANAGER
  CONSTRUCTION_MANAGER
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum StageStatus {
  PLANNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DependencyType {
  FINISH_TO_START
  START_TO_START
  FINISH_TO_FINISH
  START_TO_FINISH
}

enum ResourceType {
  WORKFORCE
  EQUIPMENT
  SUBCONTRACTOR
  OTHER
}

enum MaterialStatus {
  REQUIRED
  ORDERED
  IN_TRANSIT
  AVAILABLE
  DELAYED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  ACHIEVED
  MISSED
  CANCELLED
}

enum DelaySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DelayStatus {
  OPEN
  INVESTIGATING
  RESOLVED
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskStatus {
  OPEN
  MONITORING
  MITIGATED
  CLOSED
}

enum RecoveryPlanStatus {
  PROPOSED
  APPROVED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum RequirementType {
  MATERIAL
  WORKFORCE
  EQUIPMENT
  OTHER
}

enum RequirementPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RequirementStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
}

enum NotificationType {
  INFO
  WARNING
  DELAY
  RISK
  TASK
  REQUIREMENT
  MILESTONE
  SYSTEM
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  projects Project[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  email          String   @unique
  passwordHash   String
  role           Role
  avatarUrl      String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  // Project memberships
  projectMemberships ProjectMember[]

  // Projects where user is the client or PM
  clientProjects  Project[] @relation("ProjectClient")
  managedProjects Project[] @relation("ProjectManager")

  // Work items
  assignedTasks    Task[]
  reportedDelays   Delay[]
  createdRisks     Risk[]
  recoveryPlans    RecoveryPlan[]
  requirements     Requirement[]
  siteUpdates      SiteUpdate[]
  notifications    Notification[]
  activityLogs     Activity[]

  @@map("users")
}

model Project {
  id               String        @id @default(uuid())
  organizationId   String
  name             String
  description      String?
  location         String?
  clientId         String?
  projectManagerId String?
  status           ProjectStatus @default(PLANNED)
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?
  progress         Float         @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  client         User?        @relation("ProjectClient", fields: [clientId], references: [id])
  projectManager User?        @relation("ProjectManager", fields: [projectManagerId], references: [id])

  members      ProjectMember[]
  stages       Stage[]
  tasks        Task[]
  dependencies TaskDependency[]
  milestones   Milestone[]
  resources    Resource[]
  materials    Material[]
  delays       Delay[]
  risks        Risk[]
  recoveryPlans RecoveryPlan[]
  requirements Requirement[]
  siteUpdates  SiteUpdate[]
  notifications Notification[]
  activities   Activity[]

  @@map("projects")
}

model ProjectMember {
  id          String   @id @default(uuid())
  projectId   String
  userId      String
  projectRole Role
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Stage {
  id               String      @id @default(uuid())
  projectId        String
  name             String
  description      String?
  order            Int         @default(0)
  status           StageStatus @default(PLANNED)
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?
  progress         Float       @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@map("stages")
}

model Task {
  id               String       @id @default(uuid())
  projectId        String
  stageId          String?
  name             String
  description      String?
  status           TaskStatus   @default(TODO)
  priority         TaskPriority @default(MEDIUM)
  progress         Float        @default(0)
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?
  estimatedHours   Float?
  actualHours      Float?
  assignedToId     String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage      Stage?  @relation(fields: [stageId], references: [id], onDelete: SetNull)
  assignedTo User?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  // Dependencies where this task is the predecessor
  successorDependencies TaskDependency[] @relation("PredecessorTask")
  // Dependencies where this task is the successor
  predecessorDependencies TaskDependency[] @relation("SuccessorTask")

  delays Delay[]
  risks  Risk[]
  milestones Milestone[]

  @@map("tasks")
}

model TaskDependency {
  id                String         @id @default(uuid())
  projectId         String
  predecessorTaskId String
  successorTaskId   String
  dependencyType    DependencyType @default(FINISH_TO_START)
  lagDays           Int            @default(0)
  createdAt         DateTime       @default(now())

  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  predecessorTask Task    @relation("PredecessorTask", fields: [predecessorTaskId], references: [id], onDelete: Cascade)
  successorTask   Task    @relation("SuccessorTask", fields: [successorTaskId], references: [id], onDelete: Cascade)

  // Prevent self-dependency and duplicate dependencies
  @@unique([predecessorTaskId, successorTaskId])
  @@map("task_dependencies")
}

model Resource {
  id        String       @id @default(uuid())
  projectId String
  name      String
  type      ResourceType
  quantity  Float        @default(0)
  unit      String?
  status    String       @default("AVAILABLE")
  cost      Float?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("resources")
}

model Material {
  id                  String         @id @default(uuid())
  projectId           String
  name                String
  quantityRequired    Float          @default(0)
  quantityAvailable   Float          @default(0)
  unit                String?
  status              MaterialStatus @default(REQUIRED)
  expectedDeliveryDate DateTime?
  supplier            String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("materials")
}

model Milestone {
  id          String          @id @default(uuid())
  projectId   String
  taskId      String?
  name        String
  description String?
  plannedDate DateTime?
  actualDate  DateTime?
  status      MilestoneStatus @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@map("milestones")
}

model Delay {
  id          String        @id @default(uuid())
  projectId   String
  taskId      String?
  reportedById String
  reason      String
  description String?
  delayDays   Int
  severity    DelaySeverity @default(MEDIUM)
  status      DelayStatus   @default(OPEN)
  reportedAt  DateTime      @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task       Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  reportedBy User    @relation(fields: [reportedById], references: [id])

  @@map("delays")
}

model Risk {
  id          String       @id @default(uuid())
  projectId   String
  taskId      String?
  createdById String
  title       String
  description String?
  probability Float        @default(0.5)
  impact      Float        @default(0.5)
  severity    RiskSeverity @default(MEDIUM)
  status      RiskStatus   @default(OPEN)
  mitigation  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdBy User    @relation(fields: [createdById], references: [id])

  @@map("risks")
}

model RecoveryPlan {
  id                    String             @id @default(uuid())
  projectId             String
  createdById           String
  title                 String
  description           String?
  reason                String?
  status                RecoveryPlanStatus @default(PROPOSED)
  estimatedDaysRecovered Float             @default(0)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])

  @@map("recovery_plans")
}

model Requirement {
  id          String              @id @default(uuid())
  projectId   String
  submittedById String
  title       String
  description String?
  type        RequirementType
  quantity    Float?
  unit        String?
  priority    RequirementPriority @default(MEDIUM)
  status      RequirementStatus   @default(PENDING)
  requiredBy  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submittedBy User    @relation(fields: [submittedById], references: [id])

  @@map("requirements")
}

model SiteUpdate {
  id            String   @id @default(uuid())
  projectId     String
  submittedById String
  title         String
  description   String?
  progress      Float?
  issue         String?
  photoUrls     String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submittedBy User    @relation(fields: [submittedById], references: [id])

  @@map("site_updates")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  projectId String?
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Activity {
  id          String   @id @default(uuid())
  projectId   String?
  userId      String
  action      String
  entityType  String
  entityId    String?
  description String
  metadata    Json?
  createdAt   DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user    User     @relation(fields: [userId], references: [id])

  @@map("activities")
}
